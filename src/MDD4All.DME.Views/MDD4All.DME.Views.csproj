<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- What the listing on a package feed shows. The version is only a fallback: the
       build hands in the real one, read from src/version.txt plus the run number. -->
  <PropertyGroup>
    <Version>2.0.0.0</Version>
    <Authors>Dr. Oliver Alt, mDuckLab</Authors>
    <Company>MDD4All.de</Company>
    <Copyright>(c) 2026 oalt, mDuckLab</Copyright>
    <Description>The Blazor components of MDD4All.DME, the object graph editor: a card per object, a shape of its own for lists, arrays and dictionaries, the start page, the settings dialog, and every text in two languages.</Description>
    <PackageTags>Blazor Editor ObjectGraph UI Components</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>Nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Where the package came from, and what a debugger needs to step into this code from
       a project that only has the package. The repository address is not written out: it is
       read from the git remote while packing, so moving the repository changes nothing here. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MDD4All.Reflection.TypeAnalyzer" Version="2.0.0.7" />
    <PackageReference Include="MDD4All.DME.ViewModels" Version="2.0.0.1" />
    <PackageReference Include="MDD4All.DME.AssemblyTree" Version="2.0.0.1" />
    <PackageReference Include="MDD4All.UI.Blazor" Version="2.1.0.2" />
    <PackageReference Include="Synorvia.UI.BlazorComponents" Version="2.0.0.1" />
  </ItemGroup>

</Project>
